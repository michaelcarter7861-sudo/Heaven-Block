# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_ADMOB_REWARDED_ID: Optional Google AdMob Rewarded Ad Unit ID for Android builds.
# Defaults to Google's official test Rewarded Ad Unit ID when omitted.
VITE_ADMOB_REWARDED_ID=""

# VITE_SHARE_BASE_URL: Optional public HTTPS base URL used for "Play this same board" links.
# Required for useful share links in native Android builds, because Capacitor serves from https://localhost.
# Example: VITE_SHARE_BASE_URL="https://your-public-domain.example"
VITE_SHARE_BASE_URL=""
